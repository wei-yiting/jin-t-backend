# --- Required ---

# OpenAI key used when the caller supplies none (free tier)
FREE_TIER_OPENAI_API_KEY=

# RSA private key (PEM) for decrypting user-supplied API keys
API_KEY_ENCRYPTION_PRIVATE_KEY=

# Comma-separated CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Redis connection; docker compose overrides this to the compose service
REDIS_URL=redis://localhost:6379/0


# --- Optional: LangSmith tracing ---

LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=


# --- Optional: Cloudflare R2 audio capture (consent-based collection) ---

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
